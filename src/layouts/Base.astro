---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.short}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const nav = [
  { href: '/notes/', label: 'Notes' },
  { href: '/deep-dives/', label: 'Deep dives' },
  { href: '/reading/', label: 'Reading' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@LuccaLisciati" />
    <meta name="theme-color" content="#0f1621" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE.short}</a>
      <nav aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <a href={SITE.github}>GitHub</a>
      <a href={SITE.x}>X</a>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: var(--gutter);
    top: 0.5rem;
    background: var(--ink-raised);
    padding: 0.4rem 0.8rem;
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 2rem;
    padding-bottom: 4rem;
    font-family: var(--sans);
  }
  .site-header a {
    text-decoration: none;
  }
  .home {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 0.95rem;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--elephant);
    text-underline-offset: 0.35em;
  }
  main {
    min-height: 60vh;
  }
  .site-footer {
    display: flex;
    gap: 1.25rem;
    padding-top: 5rem;
    padding-bottom: 3rem;
    font-family: var(--sans);
    font-size: var(--step--1);
  }
  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--text);
  }
</style>
