---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  // default: column width. wide: slightly wider than the text. contain: capped height, centered.
  variant?: 'default' | 'wide' | 'contain';
}

const { src, alt, caption, variant = 'default' } = Astro.props;
---

<figure class:list={['figure', variant]}>
  <Image src={src} alt={alt} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }
  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--rule);
  }
  figcaption {
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--muted);
  }

  .wide {
    width: min(120%, calc(100vw - 2rem));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }
  @media (max-width: 640px) {
    .wide {
      width: 100%;
      left: 0;
      transform: none;
    }
  }

  .contain :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 70vh;
    margin: 0 auto;
    object-fit: contain;
  }
  .contain figcaption {
    text-align: center;
  }
</style>
