---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/content';

const posts = await getPosts('deep-dive');
---

<Base title="deep dives" description="Longer pieces on how databases work inside.">
  <h1>deep dives</h1>
  <p class="lede">longer pieces on how databases work inside.</p>
  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="muted">nothing yet. the first one will be about my SQLite clone.</p>
    )
  }
</Base>

<style>
  .lede {
    color: var(--muted);
    margin-bottom: 2.5rem;
  }
</style>
