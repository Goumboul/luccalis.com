---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/content';

const posts = await getPosts('note');
---

<Base title="notes" description="Short things I learned about databases.">
  <h1>notes</h1>
  <p class="lede">short things i learned, usually from a bug.</p>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">nothing yet.</p>}
</Base>

<style>
  .lede {
    color: var(--muted);
    margin-bottom: 2.5rem;
  }
</style>
