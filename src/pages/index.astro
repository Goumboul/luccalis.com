---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/content';
import { SITE } from '../consts';

const posts = await getPosts();
---

<Base>
  <h1>Lucca Lisciati&#8209;Ghazinia</h1>

  <h2>some things about me</h2>
  <ul>
    <li>I'm 20 and I study at Epitech in Toulouse.</li>
    <li>I did web development for 4 years. Now I'm focusing on databases.</li>
    <li>I'm slowly building a SQLite clone in C. It's still early.</li>
    <li>I contribute to <a href="https://github.com/dalibo/pg_activity">pg_activity</a>.</li>
    <li>I co-host databasestory with Eren, a series of interviews with database engineers.</li>
  </ul>

  <h2>writing</h2>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">nothing yet.</p>}

  <p class="find">
    find me on <a href={SITE.github}>github</a> and <a href={SITE.x}>x</a>.
  </p>
</Base>

<style>
  .find {
    margin-top: 3rem;
  }
</style>
