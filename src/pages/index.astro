---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/content';
import { SITE } from '../consts';

const posts = await getPosts();
---

<Base>
  <h1>Lucca Lisciati&#8209;Ghazinia</h1>

  <h2>some things about me</h2>
  <ul>
    <li>20, student at Epitech in Toulouse</li>
    <li>did web dev for 4 years, now going all in on databases</li>
    <li>writing a SQLite clone in C to understand how it works</li>
    <li>contributing to <a href="https://github.com/dalibo/pg_activity">pg_activity</a></li>
    <li>interviewing database engineers for Data by Story</li>
  </ul>

  <h2>writing</h2>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">nothing yet.</p>}

  <p class="find">
    find me on <a href={SITE.github}>github</a> and <a href={SITE.x}>x</a>.
  </p>
</Base>

<style>
  .find {
    margin-top: 3rem;
  }
</style>
